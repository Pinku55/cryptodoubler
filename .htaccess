# MTASK - Apache configuration for cPanel shared hosting
# ---------------------------------------------------------------------------

# Use the front controller pattern lightly: we still serve real .php files,
# but we protect sensitive folders and harden the server.

Options -Indexes
ServerSignature Off

# Default charset
AddDefaultCharset UTF-8

# ---------------------------------------------------------------------------
# Protect sensitive directories and files
# ---------------------------------------------------------------------------
<FilesMatch "(^\.|composer\.(json|lock)|\.sql$|\.md$|\.log$|\.sample\.php$)">
    Require all denied
</FilesMatch>

# Block direct access to PHP class / config / storage internals
RedirectMatch 403 ^/?(config|classes|includes|storage|database)/.*\.(php|sql|log|txt|json)$

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Browser caching for static assets
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>

# ---------------------------------------------------------------------------
# Pretty error pages (optional)
# ---------------------------------------------------------------------------
ErrorDocument 403 /index.php
ErrorDocument 404 /index.php
